      "beforeGameStart": {
        "boardCategoriesInSideboard": [ "Sideboard", "Base 1", "Base 2", "Base 3" ]
      },
      
      "mulligan": { 
        "startingHandSize": 7,
        "mulliganCount": { "max": 7 },
        "mulliganCycle": {
