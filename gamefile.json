{
  "name": "Siege & Duress",

  "cardRotation": 90,

  "deckBuilding": {
    "mainFilters": ["type", "cost", "domain"],
    
    "formats": [
      { "title": "Classic", "gameplay": "Standard", "deckRuleset": "Standard" }
    ],

    "deckRulesets": {
      "Standard": {
        "general": { "min": 60, "maxPerCard": 4},
        "categories": [
          { "category": "Sideboard", "min": 0, "max": 15 },
          { "category": "Base", "min": 0, "max": 6 }
        ]
      }
    }
    
  },
  
  "gameplay": {
    "Standard": {

      "beforeGameStart": {
        "boardCategoriesInSideboard": [ "Base" ],
        "boardCardSelection": [
          { "category": "Base", "min": 0, "max": 6, "unselectedDestination": "Base1Resources" }
        ],
        "chooseAnotherStartingPlayer": true
      },
      
      "mulligan": { 
        "startingHandSize": 7,
        "mulliganCount": { "max": 7 },
        "mulliganCycle": {
          "steps": [
            "toBottom", "shuffle", "applyPenalty", "draw"
          ],
          "selectionRange": { "min": 8 }
        }
        },
      
      
      "newTurn": { 
        "drawOnStart": true,
        "drawPerTurn": 1,
        "sharedTurn": false
      },
      
      "countersStartingValues": [],

      
      
      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            { "section": "Field" },
            { "direction": "row",
              "content": [
                { "direction": "column",
                  "content": [
                    { "section": "Base1Play" },
                    { "section": "Base1Resources" }
                  ]
                },
                { "direction": "column",
                  "content": [
                    { "section": "Base2Play" },
                    { "section": "Base2Resources"}
                  ]
                },
                { "direction": "column",
                  "content": [
                    { "section": "Base3Play" },
                    { "section": "Base3Resources" }
                  ]
                }
              ]
            }
          ]
        },

          "autoPlayFromHand": {
            "Unit": "Base1Play",
            "Skill": "Stack",
            "Equipment": "Base1Play",
            "Base": "Base1Resources"
          },
          "autoPlayFromStack": {
            "Skill": "Discard"
          },

        "sectionsDict": {
          "Field": { "isHidden": "no", "height": 13.75, "alignment": "CENTER" },
          "Base1Play": { "isHidden": "no", "height": 13.75, "alignment": "CENTER" },
          "Base1Resources": { "isHidden": "no", "height": 10, "alignment": "START" },
          "Base2Play": { "isHidden": "no", "height": 13.75, "alignment": "CENTER" },
          "Base2Resources": { "isHidden": "no", "height": 10, "alignment": "START" },
          "Base3Play": { "isHidden": "no", "height": 13.75, "alignment": "CENTER" },
          "Base3Resources": { "isHidden": "no", "height": 10, "alignment": "START" }
        }
      }
    }
  },

  "cards": {
    "dataUrl": "https://mattdewyt.github.io/SiegeAndDuressTCG/cards.json",
    "cardBack": "https://mattdewyt.github.io/SiegeAndDuressTCG/cards/SiegeAndDuressCardBack.png"
  }
}
